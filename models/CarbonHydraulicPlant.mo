model CarbonHydraulicPlant
  parameter Integer n=20;
  parameter Integer lanes=10;
  parameter Real P=10000 "Shaft W per lane";
  parameter Real dt=180;
  parameter Real modulus=324e9;
  parameter Real density=1790;
  parameter Real stress=3.5e9 "Scenario stress; not a fatigue allowable";
  parameter Real L=100;
  parameter Real cutoff=0.3;
  parameter Real etaCylinder=0.95;
  parameter Real etaLine=0.97;
  parameter Real etaVol=0.95;
  parameter Real etaMech=0.95;
  parameter Real pPeak=30e6 "Cylinder discharge differential pressure Pa";
  parameter Real rpm=1000;
  parameter Real eta=etaCylinder*etaLine*etaVol*etaMech;
  parameter Real E0=P*dt/(eta*(1-cutoff^2));
  parameter Real x0=stress*L/modulus;
  parameter Real area=2*E0*modulus/(stress^2*L);
  parameter Real k=modulus*area/L;
  parameter Real cylinderArea=etaCylinder*stress*area/pPeak;
  parameter Real activeMass=lanes*n*area*L*density;
  Real y[n](each start=x0^2,each fixed=true) "Squared bundle extension m2";
  Real x[n];
  Real p[n];
  Real Q[n];
  Real displacement[n] "Motor swept m3 per revolution";
  Real velocity[n];
  Real shaftPower;
  Real totalFlow;
  Real stored;
  Real delivered(start=0,fixed=true);
  Real cylinderLoss(start=0,fixed=true);
  Real lineLoss(start=0,fixed=true);
  Real motorLoss(start=0,fixed=true);
  Real oilThroughput(start=0,fixed=true);
  Real residual;
equation
  for j in 1:n loop
    der(y[j])=if time>=(j-1)*dt and time<j*dt then -2*P/(eta*k) else 0;
    x[j]=sqrt(max(y[j],0));
    p[j]=etaCylinder*k*x[j]/cylinderArea;
    Q[j]=if time>=(j-1)*dt and time<j*dt then P/(etaLine*etaVol*etaMech*p[j]) else 0;
    velocity[j]=Q[j]/cylinderArea;
    displacement[j]=Q[j]*etaVol/(rpm/60);
  end for;
  shaftPower=if time<n*dt then lanes*P else 0;
  totalFlow=lanes*sum(Q);
  stored=lanes*sum(y)*k/2;
  der(delivered)=shaftPower;
  der(cylinderLoss)=shaftPower/eta*(1-etaCylinder);
  der(lineLoss)=shaftPower/eta*etaCylinder*(1-etaLine);
  der(motorLoss)=shaftPower/eta*etaCylinder*etaLine*(1-etaVol*etaMech);
  der(oilThroughput)=totalFlow;
  residual=stored+delivered+cylinderLoss+lineLoss+motorLoss-lanes*n*E0;
end CarbonHydraulicPlant;
